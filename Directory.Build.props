<Project>
  <PropertyGroup>
    <Company>Carpe Diem Systems</Company>
    <Copyright>Carpe Diem Systems (c) 2025</Copyright>
    <Authors>Jon Shadforth</Authors>
    <!-- MinVer: uppercase 'V' tag prefix, matching the fleet-wide convention -->
    <MinVerTagPrefix>V</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
