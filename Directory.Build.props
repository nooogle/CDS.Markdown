<Project>

  <!-- NuGet audit: high/critical advisories break the build in CI only, so a
       new advisory published mid-session never blocks local work. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <Company>Carpe Diem Systems</Company>
    <Copyright>Carpe Diem Systems (c) 2025</Copyright>
    <Authors>Jon Shadforth</Authors>
    <!-- MinVer: uppercase 'V' tag prefix, matching the fleet-wide convention -->
    <MinVerTagPrefix>V</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
